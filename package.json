{
  "name": "bounty-guard",
  "version": "0.2.1",
  "description": "AI 代码安全审查助手 —— 规则引擎初筛 + LLM 复核，守住每一行 diff",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "bounty-guard": "./dist/index.js"
  },
  "homepage": "https://github.com/Croesus-K/bounty-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Croesus-K/bounty-guard.git"
  },
  "bugs": {
    "url": "https://github.com/Croesus-K/bounty-guard/issues"
  },
  "keywords": [
    "security",
    "code-review",
    "static-analysis",
    "llm",
    "github-action"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
